<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>DeepCoolDigitalProbe</AssemblyName>
    <RootNamespace>DeepCoolDigitalProbe</RootNamespace>
    <Deterministic>true</Deterministic>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="HidSharp">
      <HintPath>..\..\lib\HidSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FanControl.IPC">
      <HintPath>..\..\lib\FanControl.IPC.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Grpc.Core.Api">
      <HintPath>..\..\lib\Grpc.Core.Api.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GrpcDotNetNamedPipes">
      <HintPath>..\..\lib\GrpcDotNetNamedPipes.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\lib\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>..\..\lib\System.Memory.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>..\..\lib\System.Buffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>..\..\lib\System.Numerics.Vectors.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\..\lib\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <Reference Include="FanControl.IPC">
      <HintPath>..\..\lib\FanControl.IPC.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Grpc.Core.Api">
      <HintPath>..\..\lib\Grpc.Core.Api.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GrpcDotNetNamedPipes">
      <HintPath>..\..\lib\GrpcDotNetNamedPipes.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\lib\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FanControl.DeepCoolDigital.Core\FanControl.DeepCoolDigital.Core.csproj" />
  </ItemGroup>

</Project>
